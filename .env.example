STAGE=dev
PORT=5000
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000/api
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=my_backend
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

JWT_SECRET=replace_with_at_least_32_characters
API_KEY_PREFIX=mybackend_

# Blog assets: local is appropriate for development and stores files in an
# ignored directory. Set BLOG_ASSET_DRIVER=r2 in production and provide the
# four R2 values below.
BLOG_ASSET_DRIVER=local
BLOG_ASSET_LOCAL_DIR=.local/blog-assets
BLOG_ASSET_MAX_BYTES=8388608

# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
