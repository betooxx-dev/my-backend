{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "collectCoverageFrom": [
    "<rootDir>/src/**/*.ts",
    "!<rootDir>/src/**/*.spec.ts",
    "!<rootDir>/src/main.ts"
  ],
  "coverageDirectory": "<rootDir>/coverage/e2e",
  "coverageThreshold": {
    "global": {
      "branches": 65,
      "functions": 70,
      "lines": 80,
      "statements": 80
    }
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@config/(.*)$": "<rootDir>/src/config/$1",
    "^@modules/(.*)$": "<rootDir>/src/modules/$1",
    "^@common/(.*)$": "<rootDir>/src/common/$1"
  },
  "maxWorkers": 1,
  "modulePathIgnorePatterns": [
    "<rootDir>/.agents/",
    "<rootDir>/.claude/",
    "<rootDir>/.codex-run/",
    "<rootDir>/graphify-out/"
  ],
  "testTimeout": 120000
}
